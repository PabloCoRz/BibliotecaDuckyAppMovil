<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Global actions for drawer navigation -->
    <action android:id="@+id/action_to_prestamos" app:destination="@id/prestamosFragment" />
    <action android:id="@+id/action_to_multas" app:destination="@id/multasFragment" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.pablo.ducky.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_landing"
            app:destination="@id/landingFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_signup"
            app:destination="@id/signupFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.pablo.ducky.ui.auth.SignupFragment"
        android:label="Signup">
        <action
            android:id="@+id/action_signup_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/landingFragment"
        android:name="com.pablo.ducky.ui.landing.LandingFragment"
        android:label="Landing">
        <argument
            android:name="query"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_landing_to_search"
            app:destination="@id/searchFragment" />
        <action
            android:id="@+id/action_landing_to_detalle"
            app:destination="@id/detalleFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.pablo.ducky.ui.search.SearchFragment"
        android:label="Buscar Libros">
        <argument
            android:name="query"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_search_to_detalle"
            app:destination="@id/detalleFragment" />
    </fragment>

    <fragment
        android:id="@+id/detalleFragment"
        android:name="com.pablo.ducky.ui.detail.DetalleFragment"
        android:label="Detalle">
        <argument
            android:name="libroId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/prestamosFragment"
        android:name="com.pablo.ducky.ui.prestamos.PrestamosFragment"
        android:label="Mis Prestamos" />

    <fragment
        android:id="@+id/multasFragment"
        android:name="com.pablo.ducky.ui.multas.MultasFragment"
        android:label="Mis Multas" />

</navigation>
