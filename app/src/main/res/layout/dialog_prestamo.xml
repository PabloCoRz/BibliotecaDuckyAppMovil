<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/cream"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Solicitar Préstamo"
        android:textColor="@color/navy"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Book info card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/imgPortadaDialog"
            android:layout_width="56dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_portada_placeholder"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTituloDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/navy"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtSubtituloDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/stone"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtAutorDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/stone"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtDisponiblesDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#15803d"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Detalles del prestamo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalles del Préstamo"
        android:textColor="@color/navy"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- Fecha solicitud -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fecha de Solicitud:"
            android:textColor="@color/stone"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtFechaSolicitud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/navy"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Fecha devolucion -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fecha de Devolución:"
            android:textColor="@color/stone"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtFechaDevolucion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/navy"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Info box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF8E7"
        android:padding="10dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ El préstamo tiene una duración de 8 días hábiles (1 semana)."
            android:textColor="#92700A"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Terminos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF0F0"
        android:padding="10dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠ Términos y Condiciones de Préstamo\n\nAl no realizar la devolución del libro en la fecha indicada, se aplicará un cargo calculado por día de retraso. En caso de pérdida o daño del libro, el estudiante deberá cubrir el costo total de reposición del ejemplar."
            android:textColor="#c0392b"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Comprobante selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escoge como quieres que te demos el comprobante"
        android:textColor="@color/navy"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerComprobante"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_auth"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Confirm button -->
    <TextView
        android:id="@+id/btnHacerReserva"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button_gold"
        android:text="Hacer Reserva De Préstamo"
        android:textColor="@color/navy"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Cancel button -->
    <TextView
        android:id="@+id/btnCancelar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/white"
        android:text="Cancelar"
        android:textColor="@color/navy"
        android:textSize="14sp"
        android:gravity="center" />

</LinearLayout>